{
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "backend/src/**/*.ts",
      "backend/integracion/**/*.ts",
      "backend/e2e/**/*.ts",
      "backend/prisma/**/*.ts",
      "backend/*.ts",
      "carga/**/*.js",
      "carga/**/*.mjs",
      "frontend/**/*.js",
      "frontend/**/*.css",
      "!backend/src/generated"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" },
    "globals": ["__ENV"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "warn" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": { "enabled": false }
}
