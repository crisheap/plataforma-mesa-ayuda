# Copia este archivo a .env (junto a docker-compose.yml) y completa los valores.
POSTGRES_PASSWORD=cambia-esta-clave
JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@mesaayuda.local
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=https://mesa.tu-dominio.gov.co
# Si el asistente y el worker corren aparte (perfil «microservicios»), desactiva los embebidos en la API:
# EMBED_ASISTENTE=false
# RUN_WORKER=false
IA_PROVIDER=local
# Métricas para Prometheus en /api/metrics (vacío = deshabilitadas):
# METRICS_TOKEN=
# Días que se guardan las conversaciones de Botito sin actividad (0 = no borrar):
# ASISTENTE_RETENCION_DIAS=180
# Seguridad (RF-SEG): dificultad del captcha, conexiones a la base y revisión de integridad
# CAPTCHA_BITS=15
# DB_POOL_MAX=20
# RATE_LIMIT_IP_MIN=20000
# INTEGRIDAD_MINUTOS=10
# Respaldos (perfil «respaldos»):
# RESPALDO_CADA_HORAS=24
# RESPALDO_CONSERVAR_DIAS=14
