// Plataforma Mesa de Ayuda – SENA · Esquema v2.0
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enumeraciones ─────────────
enum RolNombre {
  USUARIO
  TECNICO
  SUPERVISOR
  ADMINISTRADOR
}

enum EstadoUsuario {
  ACTIVO
  BLOQUEADO
  INACTIVO
}

enum TipoCaso {
  INCIDENTE
  REQUERIMIENTO
  MANTENIMIENTO
  SOLICITUD_ACCESO
  OTROS
}

enum CategoriaCaso {
  HARDWARE
  SOFTWARE
  RED
  CORREO
  PLATAFORMAS_INSTITUCIONALES
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoCaso {
  ABIERTO
  ASIGNADO
  EN_PROCESO
  RESUELTO
  CERRADO
}

/// Tipo del correo de acceso (RF-USU-09): se deduce del dominio y el administrador puede cambiarlo.
enum TipoCorreo {
  EMPRESARIAL
  PERSONAL
}

/// Motivo de un enlace de acceso de un solo uso (RF-USU-10).
enum MotivoAcceso {
  BIENVENIDA
  RESTABLECER
}

enum TemaPreferido {
  CLARO
  OSCURO
  SISTEMA
}

enum VisibilidadObservacion {
  PUBLICA
  INTERNA
}

enum RolMensaje {
  USUARIO
  ASISTENTE
}

// ───────────── Identidad ─────────────
model Rol {
  id        Int       @id @default(autoincrement())
  nombre    RolNombre @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuarios Usuario[]

  @@map("roles")
}

/// Centro de formación (RF-CEN-01). Cada centro tiene sus propios usuarios, técnicos, supervisores y casos.
model Centro {
  id        Int      @id @default(autoincrement())
  /// Código corto e inmutable; es el prefijo del número de caso (CEET-2026-000001).
  codigo    String   @unique @db.VarChar(10)
  nombre    String   @db.VarChar(150)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios  Usuario[]
  casos     Caso[]
  contadores ContadorCaso[]

  @@map("centros")
}

model Usuario {
  id                  Int           @id @default(autoincrement())
  nombre              String
  apellido            String
  correo              String        @unique
  password            String
  estado              EstadoUsuario @default(ACTIVO)
  intentosFallidos    Int           @default(0)
  bloqueadoHasta      DateTime?
  ultimoAcceso        DateTime?
  preferenciaTema     TemaPreferido @default(SISTEMA)
  debeCambiarPassword Boolean       @default(false)
  /// Correo con el que inicia sesión (correo) y su tipo; el personal recibe la bienvenida y los enlaces de acceso.
  tipoCorreo          TipoCorreo    @default(EMPRESARIAL)
  /// Único en todo el sistema y distinto de cualquier correo de acceso (RF-USU-11).
  correoPersonal      String?       @unique @db.VarChar(150)
  /// Prueba de la autorización de tratamiento de datos personales (Ley 1581 de 2012; Decreto 1074 de 2015).
  datosAutorizadosEn  DateTime?
  datosVersion        String?       @db.VarChar(20)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  /// Centro al que pertenece. Solo el administrador general (rol ADMINISTRADOR) no tiene centro.
  centroId Int?
  centro   Centro? @relation(fields: [centroId], references: [id], onDelete: Restrict)

  casosCreados      Caso[]                  @relation("CasosCreados")
  casosAsignados    Caso[]                  @relation("CasosAsignados")
  historialCasos    HistorialCaso[]
  observaciones     Observacion[]
  calificaciones    Calificacion[]
  evidencias        Evidencia[]
  auditorias        Auditoria[]
  notificaciones    Notificacion[]
  intentoLogins     IntentoLogin[]
  refreshTokens     RefreshToken[]
  suscripcionesPush SuscripcionPush[]
  conversaciones    ConversacionAsistente[]
  tokensAcceso      TokenAcceso[]

  @@index([centroId])
  @@map("usuarios")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ───────────── Casos ─────────────
model Caso {
  id          Int           @id @default(autoincrement())
  numeroCaso  String        @unique
  titulo      String
  descripcion String
  tipo        TipoCaso
  categoria   CategoriaCaso
  // Número para que el técnico contacte al solicitante (RF-CAS-14). Opcional.
  telefonoContacto String?    @db.VarChar(20)
  prioridad   Prioridad     @default(MEDIA)
  estado      EstadoCaso    @default(ABIERTO)

  fechaCreacion   DateTime  @default(now())
  fechaAsignacion DateTime?
  fechaResolucion DateTime?
  fechaCierre     DateTime?
  slaVenceEn      DateTime?
  slaAlertado     Boolean   @default(false)

  usuarioId Int
  usuario   Usuario @relation("CasosCreados", fields: [usuarioId], references: [id])

  tecnicoId Int?
  tecnico   Usuario? @relation("CasosAsignados", fields: [tecnicoId], references: [id])

  /// Centro del solicitante al crear el caso; define quién puede verlo y atenderlo.
  centroId Int
  centro   Centro @relation(fields: [centroId], references: [id])

  historial      HistorialCaso[]
  evidencias     Evidencia[]
  observaciones  Observacion[]
  calificacion   Calificacion?
  conversaciones ConversacionAsistente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([usuarioId])
  @@index([tecnicoId])
  @@index([centroId])
  @@map("casos")
}

/// Consecutivo de casos por centro y año (CEET-2026-000001).
model ContadorCaso {
  centroId Int
  anio     Int
  ultimo   Int    @default(0)
  centro   Centro @relation(fields: [centroId], references: [id], onDelete: Cascade)

  @@id([centroId, anio])
  @@map("contadores_caso")
}

model HistorialCaso {
  id             Int         @id @default(autoincrement())
  estadoAnterior EstadoCaso?
  estadoNuevo    EstadoCaso
  descripcion    String?
  fecha          DateTime    @default(now())

  casoId Int
  caso   Caso @relation(fields: [casoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("historial_casos")
}

model Evidencia {
  id            Int      @id @default(autoincrement())
  nombreArchivo String
  rutaArchivo   String
  tipoArchivo   String
  tamano        Int
  createdAt     DateTime @default(now())

  casoId Int
  caso   Caso @relation(fields: [casoId], references: [id])

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("evidencias")
}

model Observacion {
  id          Int                    @id @default(autoincrement())
  contenido   String
  visibilidad VisibilidadObservacion @default(PUBLICA)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  casoId Int
  caso   Caso @relation(fields: [casoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("observaciones")
}

model Calificacion {
  id         Int      @id @default(autoincrement())
  puntuacion Int
  comentario String?
  createdAt  DateTime @default(now())

  casoId Int  @unique
  caso   Caso @relation(fields: [casoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("calificaciones")
}

// ───────────── SLA, notificaciones, auditoría ─────────────
model ConfiguracionSLA {
  id           Int       @id @default(autoincrement())
  prioridad    Prioridad @unique
  tiempoMaximo Int // minutos
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("configuracion_sla")
}

model Notificacion {
  id              Int       @id @default(autoincrement())
  titulo          String
  mensaje         String
  tipo            String    @default("GENERAL")
  casoId          Int?
  leida           Boolean   @default(false)
  correoPendiente Boolean   @default(false)
  correoEnviadoAt DateTime?
  correoIntentos  Int       @default(0)
  createdAt       DateTime  @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, leida])
  @@index([correoPendiente])
  @@map("notificaciones")
}

model SuscripcionPush {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("suscripciones_push")
}

model Auditoria {
  id          Int      @id @default(autoincrement())
  accion      String
  entidad     String
  entidadId   Int?
  descripcion String?
  datos       Json?
  ip          String?
  createdAt   DateTime @default(now())

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([createdAt])
  @@map("auditorias")
}

model IntentoLogin {
  id        Int      @id @default(autoincrement())
  exitoso   Boolean
  ip        String?
  createdAt DateTime @default(now())

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("intentos_login")
}

// ───────────── Asistente IA ─────────────
model ConversacionAsistente {
  id            Int      @id @default(autoincrement())
  titulo        String?
  escaladaACaso Boolean  @default(false)
  createdAt     DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  casoId Int?
  caso   Caso? @relation(fields: [casoId], references: [id])

  mensajes MensajeAsistente[]

  @@index([usuarioId])
  @@map("conversaciones_asistente")
}

model MensajeAsistente {
  id        Int        @id @default(autoincrement())
  rol       RolMensaje
  contenido String
  util      Boolean?
  createdAt DateTime   @default(now())

  conversacionId Int
  conversacion   ConversacionAsistente @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId])
  @@map("mensajes_asistente")
}

model ArticuloConocimiento {
  id            Int            @id @default(autoincrement())
  titulo        String
  contenido     String
  palabrasClave String[]
  categoria     CategoriaCaso?
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("articulos_conocimiento")
}

/// Enlace de un solo uso para crear o restablecer la contraseña (RF-USU-10). Se guarda solo el hash.
model TokenAcceso {
  id        Int          @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String       @unique @db.Char(64)
  motivo    MotivoAcceso
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime     @default(now())

  @@index([usuarioId])
  @@map("tokens_acceso")
}

/// Parámetros del sistema editables por el administrador (p. ej. dominios de correo empresariales, RF-ADM-05).
model ConfiguracionSistema {
  clave     String   @id @db.VarChar(60)
  valor     Json
  updatedAt DateTime @updatedAt

  @@map("configuracion_sistema")
}

/// Eventos de seguridad (RF-SEG-02): intentos de acceso, ataques y acciones de emergencia.
enum SeveridadSeguridad {
  INFO
  ADVERTENCIA
  CRITICA
}

model EventoSeguridad {
  id          Int                @id @default(autoincrement())
  tipo        String             @db.VarChar(40)
  severidad   SeveridadSeguridad
  descripcion String             @db.VarChar(300)
  ip          String?            @db.VarChar(64)
  correo      String?            @db.VarChar(150)
  usuarioId   Int?
  centroId    Int?
  datos       Json?
  /// Repeticiones agrupadas del mismo evento (misma IP, tipo y cuenta) en pocos minutos.
  veces       Int                @default(1)
  ultimoEn    DateTime           @default(now())
  atendido    Boolean            @default(false)
  atendidoPor Int?
  atendidoEn  DateTime?
  createdAt   DateTime           @default(now())

  @@index([createdAt])
  @@index([centroId, createdAt])
  @@index([severidad, atendido])
  @@map("eventos_seguridad")
}
