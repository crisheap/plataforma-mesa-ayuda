{
  "name": "mesa-ayuda-backend",
  "version": "2.0.0",
  "description": "Plataforma Mesa de Ayuda – SENA · API v2.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:asistente": "tsx watch src/asistente/server.ts",
    "dev:worker": "tsx watch src/worker/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:asistente": "node dist/asistente/server.js",
    "start:worker": "node dist/worker/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.test --import tsx --test \"src/**/*.test.ts\"",
    "test:integracion": "node --import tsx --test \"integracion/**/*.integracion.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.16",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
