# ── Base de datos ──
DATABASE_URL="postgresql://usuario:clave@localhost:5432/mesa_ayuda?schema=public"

# ── Servidor ──
PORT=4000
NODE_ENV=development
# Orígenes permitidos por CORS (separados por coma). El mismo origen siempre se permite.
CORS_ORIGINS=http://localhost:4000
# Poner true si la API está detrás de un proxy inverso (Nginx, Caddy)
TRUST_PROXY=false
# Carpeta del frontend PWA servida por la API (ruta relativa a backend/)
FRONTEND_DIR=../frontend

# ── Seguridad (OBLIGATORIO: usa un secreto largo y aleatorio, mínimo 32 caracteres en producción) ──
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# ── Seed ──
ADMIN_EMAIL=admin@mesaayuda.local
# Si se omite, el seed genera una contraseña aleatoria y la muestra una sola vez
ADMIN_INITIAL_PASSWORD=

# ── Evidencias ──
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ── Correo (opcional; sin SMTP_HOST los correos se escriben en consola). Requiere: npm install nodemailer ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mesa de Ayuda SENA <no-reply@mesaayuda.local>"

# ── Correos de bienvenida y acceso (RF-USU-09/10, RF-ADM-05) ──
# Dirección pública de la plataforma; con ella se arman los enlaces de los correos.
APP_URL=http://localhost:4000
# Horas de vigencia del enlace para crear o restablecer la contraseña (un solo uso).
ACCESO_VIGENCIA_HORAS=48
# Dominios empresariales iniciales, separados por coma. Después se cambian en Configuración.
DOMINIOS_EMPRESARIALES=sena.edu.co,misena.edu.co

# ── Datos personales (RF-DAT-01; Ley 1581 de 2012) ──
# Responsable del tratamiento y canal para consultas y reclamos, tal como los muestra la política.
DATOS_RESPONSABLE="Servicio Nacional de Aprendizaje – SENA"
# Correo o enlace de atención para datos personales. Vacío: la política remite a los canales del SENA.
DATOS_CONTACTO=

# ── Push web (opcional). Requiere: npm install web-push. Genera claves con: npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@mesaayuda.local

# ── Asistente IA ──
# local = respuestas con la base de conocimiento (sin servicios externos) | anthropic = usa la API de mensajes
IA_PROVIDER=local
IA_API_KEY=
IA_MODEL=
IA_MAX_MENSAJES_MIN=20
# URL del núcleo (solo si el asistente corre como servicio aparte)
CORE_API_URL=http://localhost:4000
ASISTENTE_PORT=4100
EMBED_ASISTENTE=true
RUN_WORKER=true

# ── Asistente: retención de conversaciones (RF-IA-07, RNF-13) ──
# Días sin actividad tras los cuales se borran las conversaciones de Botito. 0 = no borrar nunca.
ASISTENTE_RETENCION_DIAS=180

# ── Observabilidad (RNF-14) ──
# Registro por petición: json (recomendado en producción), texto o no.
LOG_PETICIONES=texto
# Token para leer /api/metrics (formato Prometheus). Vacío = métricas deshabilitadas.
METRICS_TOKEN=
# Peticiones por minuto de cada persona (o IP sin sesión) a /api.
RATE_LIMIT_API_MIN=600
# ── Seguridad (RF-SEG-01 a 05) ──
# Límite total por IP (toda una sede sale por la misma IP: debe ser alto).
RATE_LIMIT_IP_MIN=20000
# Dificultad del captcha propio (bits en cero de SHA-256). 15 ≈ 1 s en un computador normal;
# sube sola con los intentos fallidos desde la misma IP. Valores de 1 a 24.
CAPTCHA_BITS=15
# Conexiones simultáneas a PostgreSQL por instancia de la API.
DB_POOL_MAX=20
# Días que se guardan los eventos de seguridad.
RETENCION_SEGURIDAD_DIAS=180
# Cada cuántos minutos se revisa la integridad del código (solo con el manifiesto de Docker).
INTEGRIDAD_MINUTOS=10
